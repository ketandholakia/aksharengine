  "id": "sutonnymj-bengali",
  "name": "SutonnyMJ (Bengali)",
  "script": "bengali",
  "language": "bn",
  "version": "1.0.0",
  "author": {
    "name": "AksharEngine Base",
    "url": "https://github.com/bahar/BijoyToUnicode"
  },
  "fontFamilies": [
    "SutonnyMJ",
    "SutonnyOMJ",
    "SolaimanLipi Legacy"
  ],
  "isBuiltIn": true,
  "reorderingRules": {
    "leftMatraSymbols": [],
    "rephSymbols": [],
    "customTransforms": [
      {
        "pattern": "্্",
        "replacement": "্",
        "description": "Double halant -> single halant"
      },
      {
        "pattern": "্‌্‌",
        "replacement": "্‌",
        "description": "Double halant+ZWNJ -> single"
      },
      {
        "pattern": "্‌্",
        "replacement": "্‌",
        "description": "Mixed doubled halant -> halant+ZWNJ"
      },
      {
        "pattern": "(?<!্)([ক-হৎংঃঁ](?:্(?:‌)?[ক-হৎংঃঁ])*|[াোৌৗুূীৃেিৈঁ])র্",
        "replacement": "র্$1",
        "description": "Reph র্ moved before preceding cluster"
      },
      {
        "pattern": "([াোৌৗুূীৃেিৈঁ])(্)([ক-হৎংঃঁ])",
        "replacement": "$2$3$1",
        "description": "Kar before halant reordered after cluster"
      },
      {
        "pattern": "(?<!্)র্([াোৌৗুূীৃ])",
        "replacement": "$1র্",
        "description": "র্ + kar swapped"
      },
      {
        "pattern": "ে([ক-হৎংঃঁ](?:্(?:‌)?[ক-হৎংঃঁ])*)",
        "replacement": "$1ে",
        "description": "ে moved after cluster"
      },
      {
        "pattern": "ি([ক-হৎংঃঁ](?:্(?:‌)?[ক-হৎংঃঁ])*)",
        "replacement": "$1ি",
        "description": "ি moved after cluster"
      },
      {
        "pattern": "ৈ([ক-হৎংঃঁ](?:্(?:‌)?[ক-হৎংঃঁ])*)",
        "replacement": "$1ৈ",
        "description": "ৈ moved after cluster"
      },
      {
        "pattern": "ো",
        "replacement": "ো",
        "description": "ে + া -> ো"
      },
      {
        "pattern": "ৌ",
        "replacement": "ৌ",
        "description": "ে + ৗ -> ৌ"
      },
      {
        "pattern": "ঁ([াোৌৗুূীৃ])",
        "replacement": "$1ঁ",
        "description": "Nukta moved after kaar"
      },
      {
        "pattern": "অা",
        "replacement": "আ",
        "description": "অ + া -> আ"
      },
      {
        "pattern": "([০-৯])ঃ",
        "replacement": "$1:",
        "description": "Digit + visarga -> digit + colon"
      },
      {
        "pattern": " ঃ",
        "replacement": " :",
        "description": "Space + visarga -> space + colon"
      },
      {
        "pattern": "\\]ঃ",
        "replacement": "]:",
        "description": "] + visarga -> ] + colon"
      },
      {
        "pattern": "\\[ঃ",
        "replacement": "[:",
        "description": "[ + visarga -> [ + colon"
      },
      {
        "pattern": " ,",
        "replacement": ",",
        "description": "Space before comma removed"
      },
      {
        "pattern": " {2,}",
        "replacement": " ",
        "description": "Repeated spaces collapsed"
      }
    ]
  },
